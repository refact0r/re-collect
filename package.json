{
	"name": "re-collect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently \"convex dev\" \"vite dev\"",
		"build": "vite build",
		"deploy": "pnpm run deploy:convex && pnpm run deploy:app",
		"deploy:convex": "convex deploy",
		"deploy:app": "vite build && wrangler deploy",
		"deploy:screenshot": "pnpm -C workers/screenshot run deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.550",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^1.0.0",
		"@convex-dev/r2": "^0.10.4",
		"@convex-dev/workpool": "^0.4.15",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"colorthief": "^3.5.0",
		"convex": "^1.48.0",
		"convex-svelte": "^0.15.1",
		"defuddle": "^0.19.6",
		"fractional-indexing": "^4.0.0",
		"linkedom": "^0.18.14",
		"sharp": "^0.35.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
