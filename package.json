{
	"name": "re-collect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently \"convex dev\" \"vite dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.519",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.8",
		"@convex-dev/r2": "^0.10.2",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"colorthief": "^3.5.0",
		"convex": "^1.45.0",
		"convex-svelte": "^0.14.0",
		"fractional-indexing": "^4.0.0",
		"sharp": "^0.35.3"
	}
}
