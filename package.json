{
	"name": "re-collect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently \"convex dev\" \"vite dev\"",
		"build": "vite build",
		"deploy": "pnpm run deploy:convex && pnpm run deploy:app",
		"deploy:convex": "convex deploy",
		"deploy:app": "vite build && wrangler deploy",
		"deploy:screenshot": "pnpm -C workers/screenshot run deploy",
		"deploy:screenshot-dev": "pnpm -C workers/screenshot run deploy:dev",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.556",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"concurrently": "^10.0.7",
		"convex-test": "^0.0.71",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"@convex-dev/r2": "^0.10.4",
		"@convex-dev/rate-limiter": "^0.4.3",
		"@convex-dev/workpool": "^0.4.16",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"colorthief": "^3.5.0",
		"convex": "^1.50.0",
		"convex-svelte": "^0.15.1",
		"defuddle": "^0.19.6",
		"fractional-indexing": "^4.0.0",
		"linkedom": "^0.18.15",
		"sharp": "^0.35.5",
		"umap-js": "^1.4.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
