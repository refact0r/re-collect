{
	"name": "re-collect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently \"convex dev\" \"vite dev\"",
		"build": "vite build",
		"deploy": "pnpm run deploy:convex && pnpm run deploy:app",
		"deploy:convex": "convex deploy",
		"deploy:app": "vite build && wrangler deploy",
		"deploy:screenshot": "pnpm -C workers/screenshot run deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.533",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.3",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "^4.141.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.9",
		"@convex-dev/r2": "^0.10.2",
		"@convex-dev/workpool": "^0.4.12",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"colorthief": "^3.5.0",
		"convex": "^1.46.0",
		"convex-svelte": "^0.14.0",
		"defuddle": "^0.19.4",
		"fractional-indexing": "^4.0.0",
		"linkedom": "^0.18.13",
		"sharp": "^0.35.4"
	}
}
