# Production build values (checked in - no secrets here).
# Takes precedence over .env.local during `vite build`, so deploys can't
# accidentally bake dev values. Secrets (AUTH_PASSWORD, CONVEX_WRITE_TOKEN)
# are runtime Cloudflare worker vars, not build-time.
PUBLIC_CONVEX_URL=https://rugged-anteater-859.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://rugged-anteater-859.convex.site
